    var sample30: vec3f = tap(pos + vec2f(3.0,-2.0));
    var sample31: vec3f = tap(pos + vec2f(3.0,-1.0));
    var sample32: vec3f = tap(pos + vec2f(3.0,0.0));
    var sample33: vec3f = tap(pos + vec2f(3.0,1.0));
