    var lo: vec3f = vec3f(0.0);
    var hi: vec3f = vec3f(0.0);
    var lo2: vec3f = vec3f(0.0);
    var hi2: vec3f = vec3f(0.0);
    w = textureSampleLevel(ravu_zoom_lut3, lut_sampler, vec2f(0.0, coord_y) + subpix, 0.0);
    res += sample0 * w[0];
    res += sample1 * w[1];
    res += sample2 * w[2];
    res += sample3 * w[3];
    w = textureSampleLevel(ravu_zoom_lut3, lut_sampler, vec2f(0.2, coord_y) + subpix, 0.0);
    res += sample4 * w[0];
    res += sample5 * w[1];
    res += sample6 * w[2];
    res += sample7 * w[3];
