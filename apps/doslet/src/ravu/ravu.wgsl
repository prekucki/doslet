    var luma2: f32 = dot(sample2, color_primary);
    var luma3: f32 = dot(sample3, color_primary);
    var luma4: f32 = dot(sample4, color_primary);
    var luma6: f32 = dot(sample6, color_primary);
    var luma7: f32 = dot(sample7, color_primary);
    var luma8: f32 = dot(sample8, color_primary);
    var luma9: f32 = dot(sample9, color_primary);
