    var sample9: vec3f = tap(pos + vec2f(-1.0,1.0));
    var sample10: vec3f = tap(pos + vec2f(-1.0,2.0));
    var sample11: vec3f = tap(pos + vec2f(-1.0,3.0));
    var sample12: vec3f = tap(pos + vec2f(0.0,-2.0));
    var sample13: vec3f = tap(pos + vec2f(0.0,-1.0));
    var sample14: vec3f = tap(pos + vec2f(0.0,0.0));
    var sample15: vec3f = tap(pos + vec2f(0.0,1.0));
    var sample16: vec3f = tap(pos + vec2f(0.0,2.0));
    var sample17: vec3f = tap(pos + vec2f(0.0,3.0));
    var sample18: vec3f = tap(pos + vec2f(1.0,-2.0));
