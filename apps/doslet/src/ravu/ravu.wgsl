    var pos: vec2f = uv * HOOKED_size;
    var subpix: vec2f = fract(pos - 0.5);
    pos -= subpix;
    subpix = lutpos(subpix, vec2f(9.0));
    var subpix_inv: vec2f = 1.0 - subpix;
    var subpix_ar: vec2f = subpix / vec2f(2.0, 288.0);
    var subpix_inv_ar: vec2f = subpix_inv / vec2f(2.0, 288.0);
    subpix /= vec2f(5.0, 288.0);
    subpix_inv /= vec2f(5.0, 288.0);
    var sample0: vec3f = tap(pos + vec2f(-2.0,-2.0));
